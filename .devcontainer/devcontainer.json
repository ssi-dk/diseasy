{
  "name": "diseasy",
  "image": "ghcr.io/ssi-dk/diseasy:main",
  "overrideCommand": false,
  "remoteUser": "rstudio",
  "containerEnv": {
    "ROOT": "true"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "REditorSupport.r"
      ],
      "settings": {
        "r.rpath.linux": "/usr/local/bin/R",
        "r.rterm.linux": "/usr/local/bin/arf",
        "r.bracketedPaste": true,
        "r.alwaysUseActiveTerminal": true
      }
    }
  }
}
